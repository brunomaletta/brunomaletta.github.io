---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const { title, description, current } = Astro.props;
---
<Base title={title} description={description}>
  <div class="shell">
    <Nav current={current} />
    <main class="site-main">
      <slot />
    </main>
  </div>
</Base>
