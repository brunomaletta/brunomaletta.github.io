---
import SiteLayout from "../layouts/SiteLayout.astro";
import ChipIcon from "../components/ChipIcon.astro";
import { projects } from "../data/site";
---
<SiteLayout title="Projects" current="/projects">
  <p class="kicker">GitHub</p>
  <h1>Selected repositories</h1>
  <ul class="list" style="margin-top:2rem;">
    {projects.map((p) => (
      <li class="project-row">
        <div class="project-heading">
          <a class="project-title" href={p.related ?? p.docs ?? p.href}>{p.name}</a>
          <a class="github-chip" href={p.href}>
            <ChipIcon name="github" />
            <span>GitHub</span>
          </a>
        </div>
        <span class="meta">{p.lang} · {p.blurb}</span>
      </li>
    ))}
  </ul>
</SiteLayout>
